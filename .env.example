# Copia este archivo como .env (ignorado por git) y llena los valores en tu máquina.
# Nunca pongas valores reales aquí: este archivo es público (CLAUDE.md §1.6).

# Clave de la API de Gemini (Google AI Studio). La usan `pnpm eval --adaptador=gemini`
# y la Edge Function (en la nube, con `supabase secrets set GEMINI_API_KEY=...`).
GEMINI_API_KEY=
# Opcional: modelo de Gemini; si se deja vacío se usa el de AdaptadorGemini.
GEMINI_MODELO=

# Conexión del usuario agente_api (hereda agente_lectura). Local: puerto 54322 y la
# contraseña que fija seed.sql. Para `pnpm eval --acceso=postgres` y `pnpm medir`.
URL_BASE_AGENTE=
# Conexión del administrador local (`pnpm supabase status -o env`, DB_URL). Solo `pnpm medir`.
URL_BASE_ADMIN=
