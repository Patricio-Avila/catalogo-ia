{
  "name": "catalogo-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Filtrado asistido por IA sobre catálogos con atributos heterogéneos",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:edge": "pnpm --filter web exec vite build -c vite.edge.config.ts",
    "eval": "pnpm --filter @catalogo-ia/core exec tsx ../../eval/correr.ts",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "supabase": "supabase"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "supabase": "^2.122.0",
    "typescript": "^7.0.2"
  }
}
