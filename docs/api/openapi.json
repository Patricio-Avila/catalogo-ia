{
  "openapi": "3.1.0",
  "info": {
    "title": "catalogo-ia",
    "version": "0.1.0",
    "description": "Filtrado asistido por IA sobre catálogos con atributos heterogéneos. El modelo nunca escribe SQL: devuelve un objeto de filtros validado contra el diccionario (G1) y la base lo ejecuta con funciones parametrizadas (G2)."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/salud": {
      "get": {
        "summary": "Estado de la API y versión del núcleo",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "estado": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "nucleo": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "estado",
                    "nucleo"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/verticales": {
      "get": {
        "summary": "Verticales disponibles con sus categorías, textos y aviso (selector del cliente)",
        "responses": {
          "200": {
            "description": "verticales",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verticales": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "dominio": {
                            "type": "string",
                            "enum": [
                              "farmacia",
                              "llantas",
                              "belleza"
                            ]
                          },
                          "nombre": {
                            "type": "string",
                            "minLength": 1
                          },
                          "texto_ayuda": {
                            "type": "string"
                          },
                          "aviso": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "atributos_destacados": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-z][a-z0-9_]*$"
                            }
                          },
                          "version_diccionario": {
                            "type": "string"
                          },
                          "categorias": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "categoria": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "nombre": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "categoria",
                                "nombre"
                              ]
                            }
                          }
                        },
                        "required": [
                          "dominio",
                          "nombre",
                          "texto_ayuda",
                          "aviso",
                          "atributos_destacados",
                          "version_diccionario",
                          "categorias"
                        ]
                      }
                    }
                  },
                  "required": [
                    "verticales"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/diccionario/{dominio}": {
      "get": {
        "summary": "Diccionario de atributos de una vertical (para etiquetas manuales, RF-10)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "farmacia",
                "llantas",
                "belleza"
              ]
            },
            "required": true,
            "name": "dominio",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "diccionario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dominio": {
                      "type": "string",
                      "enum": [
                        "farmacia",
                        "llantas",
                        "belleza"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "categorias": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "entradas": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "categoria": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "atributo": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "tipo": {
                            "type": "string",
                            "enum": [
                              "texto",
                              "numero",
                              "booleano"
                            ]
                          },
                          "valores": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "minimo": {
                            "type": "number"
                          },
                          "maximo": {
                            "type": "number"
                          },
                          "cobertura_pct": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "obligatorio": {
                            "type": "boolean"
                          },
                          "define_uso": {
                            "type": "boolean"
                          },
                          "define_riesgo": {
                            "type": "boolean"
                          },
                          "inferible": {
                            "type": "boolean"
                          },
                          "peso": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "categoria",
                          "atributo",
                          "tipo",
                          "cobertura_pct",
                          "obligatorio",
                          "define_uso",
                          "define_riesgo",
                          "inferible"
                        ]
                      }
                    }
                  },
                  "required": [
                    "dominio",
                    "version",
                    "categorias",
                    "entradas"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "dominio inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "peticion_invalida",
                        "no_encontrado",
                        "error_interno"
                      ]
                    },
                    "campos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ruta": {
                            "type": "string"
                          },
                          "mensaje": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "ruta",
                          "mensaje"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
